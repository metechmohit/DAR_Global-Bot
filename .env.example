# Copy to .env and add your key. Never commit .env.
OPENROUTER_API_KEY=
# Only zero-cost OpenRouter models are accepted by default.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT=45
# Optional: sentence-transformers local embeddings (see requirements-semantic.txt).
SEMANTIC_MODEL=
# Defaults put downloaded weights and package/browser caches inside .venv/cache.
# In a future container this can point to a mounted cache directory instead.
# ATLAS_CACHE_DIR=.venv/cache
HOST=127.0.0.1
PORT=8000
# Developer CSV exports and collection diagnostics are off in the public app.
ATLAS_DEV_TOOLS=0
